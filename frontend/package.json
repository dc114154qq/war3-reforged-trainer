{
  "name": "war3-trainer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fonts:fetch": "node scripts/fonts/fetch.mjs",
    "fonts:names": "python -I scripts/fonts/collect_names.py ..",
    "fonts": "python -I scripts/fonts/subset.py",
    "icons": "node scripts/icons/build.mjs",
    "assets": "npm run icons && npm run fonts",
    "check": "tsc --noEmit -p . && node scripts/check-contrast.mjs && node scripts/check-i18n.mjs && python -I scripts/fonts/subset.py --check",
    "build": "npm run check && vite build",
    "build:styleguide": "npm run check && vite build --config vite.styleguide.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
