      "cancel": "game-icons:cancel",
      "search": "game-icons:magnifying-glass",
      "chat": "game-icons:talk",
      "save": "game-icons:save",
      "export": "game-icons:scroll-unfurled",
      "open-file": "game-icons:open-folder",
      "settings": "game-icons:cog",
      "hotkey": "custom:keycap.svg"
    },
